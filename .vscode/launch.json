{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Tombola",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}\\apps\\tombolaAPI\\src\\Tombola.Api\\Tombola.Api.csproj",
      "launchSettingsProfile": "http"
    },
    {
      "name": "Page de test Tombola (Edge)",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "file:///${workspaceFolder}/apps/tombolaAPI/tests/index.html",
      "webRoot": "${workspaceFolder}\\apps\\tombolaAPI\\tests"
    },
    {
      "name": "App Shoot",
      "type": "pwa-msedge",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "userDataDir": "${env:TEMP}\\ABP.WebSite-Shoot-Edge",
      "url": "file:///${workspaceFolder}/apps/shoot/index.html",
      "webRoot": "${workspaceFolder}\\apps\\shoot"
    }
  ],
  "compounds": [
    {
      "name": "Tombola : API + page de test",
      "configurations": [
        "API Tombola",
        "Page de test Tombola (Edge)"
      ],
      "stopAll": true
    },
    {
      "name": "Tombola : API + App Shoot",
      "configurations": [
        "API Tombola",
        "App Shoot"
      ],
      "stopAll": true
    }
  ]
}
